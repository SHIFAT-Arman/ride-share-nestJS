# Copy to .env (local) or .env-prod (Render). Never commit filled secrets.

# --- App ---
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001
TRUST_PROXY=false

# --- Cookies (local HTTP: secure=false, sameSite=lax) ---
# Vercel + Render: COOKIE_SECURE=true, COOKIE_SAME_SITE=none, TRUST_PROXY=true
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- Postgres (TypeORM uses these; not DATABASE_URL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_DATABASE=
DB_SSL=false
DB_SYNCHRONIZE=true

# --- JWT ---
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Pusher (required at boot via CommonModule) ---
PUSHER_APP_id=
PUSHER_APP_key=
PUSHER_APP_secret=
PUSHER_APP_cluster=

# --- SMTP (unused while EmailService is commented out) ---
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# --- Neon tooling only (Nest TypeORM does not read these) ---
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# NEON_BRANCH=
